# Web3Forms access key — https://web3forms.com
#
# Optional. The live key is already committed as a default in
# components/contact-form.tsx, because a Web3Forms access key is a PUBLIC
# identifier — Web3Forms expects it in client-side JavaScript, and it can only
# be used to send mail as this site (rate-limited, abuseable by anyone who
# scrapes the bundle, which is the same exposure as any hosted form).
#
# Set this ONLY to override/rotate the key without editing code:
#   NEXT_PUBLIC_WEB3FORMS_KEY=your-key-here
#
# If the effective key is empty the form falls back to a mailto: link.
NEXT_PUBLIC_WEB3FORMS_KEY=
